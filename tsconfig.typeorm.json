{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "moduleResolution": "Node",
    "module": "CommonJS",
    "target": "ES2020",
    "declaration": false,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": [
    "src/data-source.ts",
    "src/server/db/**/*.ts"
  ]
}
